{
    "transform": {
        "^.+\\.tsx?$": [
            "ts-jest",
            {
                "tsconfig": "<rootDir>/../tsconfig.test.json"
            }
        ]
    },
    "testEnvironment": "jsdom",
    "rootDir": "src",
    "testMatch": ["**/__tests__/**/*.test.(js|ts)?(x)"],
    "reporters": [
        "default",
        [
            "jest-junit",
            {
                "outputDirectory": "../../test_reports",
                "outputName": "motion.xml"
            }
        ]
    ]
}
